# CascadeIQ settings. Copy to .env for local work; on a host set the same names as environment variables.
# This file holds NO secrets: keep real values only in .env (git-ignored) or in the host's secret store.

# ---- Secrets (required) ----
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=            # only if the Gemini fallback is enabled

# ---- Web / CORS ----
# Comma separated exact origins allowed to call the API (no wildcard). Include the deployed frontend.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set to 1 only behind a trusted proxy (Render, Vercel, nginx): then the first X-Forwarded-For address is the client.
TRUST_PROXY_HEADERS=0

# ---- Limits (in memory, per instance, reset on restart; 0 turns a limit off) ----
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=80
# Real model calls per day across all users (IST day). When reached, answers say "busy today" and call no provider.
GLOBAL_DAILY_MODEL_CALLS=400
FEEDBACK_PER_DAY=20
# Optional fixed salt for hashing client addresses (otherwise random per start).
RATE_LIMIT_SALT=

# ---- Providers ----
GROQ_ENABLED=true
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=
LLM_PROVIDER_ORDER=
LLM_MAX_ATTEMPTS=
LLM_MAX_TOTAL_TIME_SECONDS=
LLM_RETRY_WAIT_SECONDS=

# ---- Answers, cache, privacy ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=21600
CASCADEIQ_PLAIN_TEXT_ANSWERS=false
# Notices whose title or category contains one of these are withheld from the model (names, roll numbers).
RESTRICTED_NOTICE_PATTERNS=struck off,list of oe,readmission

# ---- Native threads (memory) ----
# Without these, the first burst of concurrent requests raised memory from about 225 MB to about 520 MB.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1

# ---- Logging ----
# Logs go to stdout as one-line records. Set LOG_FILE to also write a rotating file.
LOG_FILE=

# ---- Embeddings ----
EMBEDDING_ALLOW_DOWNLOAD=0

# ---- Ingestion pipeline ----
NOTICES_API_URL=https://infocascade-database.onrender.com/api/notices
# Hosts (exact or subdomain) the pipeline may fetch from; the NOTICES_API_URL host is always allowed.
SAFE_FETCH_ALLOWED_HOSTS=gndec.ac.in
ALLOWED_SOURCE_DOMAINS=gndec.ac.in
MIN_NOTICE_TEXT_LENGTH=40
# Overall time budget for waking the notices API before the run gives up.
WARMUP_DEADLINE_SECONDS=240
